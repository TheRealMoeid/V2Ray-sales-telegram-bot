# Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database (for local development)
# For Docker, use: postgresql+asyncpg://postgres:postgres@db:5432/v2ray_bot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/v2ray_bot

# Admin IDs (comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Bank Information
BANK_CARD_NUMBER=6037-XXXX-XXXX-XXXX
BANK_ACCOUNT_NAME=Account Holder Name
BANK_NAME=Bank Name

# Shop Configuration
SHOP_NAME=V2Ray Shop
SUPPORT_USERNAME=@support

# Inventory Settings
LOW_STOCK_THRESHOLD=5

# Logging
LOG_LEVEL=INFO
